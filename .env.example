# Copy this file to .env.local and fill in the values (that file is gitignored).
# In production, set these same variables in your Vercel project settings.

# Resend — powers the contact form's email delivery. Get a key at https://resend.com
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=contact@wingspaninnovations.com

# Verified sender address. Must be on a domain you've verified in Resend.
# Leave as the Resend sandbox sender until your domain is verified — note the
# sandbox can only deliver to the address you signed up to Resend with.
CONTACT_FROM_EMAIL=onboarding@resend.dev
